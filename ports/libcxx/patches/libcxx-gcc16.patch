+#  if _LIBCPP_GCC16_WORKAROUNDS
+// With GCC, _LIBCPP_EXCLUDE_FROM_EXPLICIT_INSTANTIATION is always_inline.
+// GCC 16 fails (an error for always_inline) to inline a virtual function
+// that a devirtualized call reaches recursively, such as std::function
+// calling itself through lambdas (LLVM's ScalarEvolution).
+#    define _LIBCPP_HIDE_FROM_ABI_VIRTUAL _LIBCPP_HIDDEN
+#  else
+#    define _LIBCPP_HIDE_FROM_ABI_VIRTUAL _LIBCPP_HIDDEN _LIBCPP_EXCLUDE_FROM_EXPLICIT_INSTANTIATION
+#  endif
 
