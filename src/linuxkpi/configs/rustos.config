# Kconfig fragment for the Linux code RustOS compiles through LinuxKPI.
# Applied on top of `allnoconfig` (ARCH=x86_64) by tools/linux-import.py;
# the generated autoconf.h lands in src/linuxkpi/include/generated/.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_HZ_250=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_DYNAMIC is not set
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_SYMBOLIC_ERRNAME=y
CONFIG_MULTIUSER=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
# Device nodes: devtmpfs_create_node() is LinuxKPI glue (src/linuxkpi/c/chrdev.c)
# publishing into RustOS devfs; drivers/base/devtmpfs.c is not used.
CONFIG_DEVTMPFS=y
# Wi-Fi (M28): cfg80211, mac80211, the hwsim test radio. Crypto comes from
# LinuxKPI glue (src/linuxkpi/c/crypto.c on lib/crypto), not from crypto/.
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
# CONFIG_CFG80211_WEXT is not set
CONFIG_EXPERT=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS is not set
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
# CONFIG_MAC80211_LEDS is not set
# CONFIG_MAC80211_DEBUGFS is not set
# CONFIG_MAC80211_MESH is not set
CONFIG_MAC80211_HWSIM=y
# MediaTek MT7921/MT7921K/MT7920/MT7922 PCIe (M29). Tracing and debugfs are
# off, so the mt76 trace/debugfs files are not compiled.
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=y
# USB (M30): the LinuxKPI USB core sits on RustOS's xHCI driver; Linux's
# usbcore (hcd, hub, usbfs) is not compiled.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
# CONFIG_USB_PCI is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_UHCI_HCD is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_UAS is not set
# CONFIG_USB_ROLE_SWITCH is not set
# CONFIG_TYPEC is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USB_ANNOUNCE_NEW_DEVICES is not set
# CONFIG_USB_DYNAMIC_MINORS is not set
# CONFIG_USB_MON is not set
CONFIG_MII=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDC_NCM=y
# CONFIG_USB_NET_CDC_EEM is not set
# CONFIG_USB_NET_NET1080 is not set
# CONFIG_USB_NET_CDC_SUBSET is not set
# CONFIG_USB_NET_ZAURUS is not set
# CONFIG_USB_NET_CDC_MBIM is not set
# CONFIG_USB_NET_HUAWEI_CDC_NCM is not set
# CONFIG_USB_LAN78XX is not set
# CONFIG_USB_NET_SMSC95XX is not set
# CONFIG_USB_NET_SMSC75XX is not set
# CONFIG_USB_NET_DM9601 is not set
# CONFIG_USB_NET_SR9700 is not set
# CONFIG_USB_NET_MCS7830 is not set
# CONFIG_USB_NET_GL620A is not set
# CONFIG_USB_NET_PLUSB is not set
# CONFIG_USB_NET_RNDIS_WLAN is not set
# CONFIG_USB_NET_QMI_WWAN is not set
# CONFIG_USB_NET_CX82310_ETH is not set
# CONFIG_USB_NET_KALMIA is not set
# CONFIG_USB_NET_INT51X1 is not set
# CONFIG_USB_NET_CH9200 is not set
# CONFIG_USB_NET_AQC111 is not set
# CONFIG_USB_SIERRA_NET is not set
# CONFIG_USB_VL600 is not set
# CONFIG_USB_PEGASUS is not set
# CONFIG_USB_RTL8150 is not set
# CONFIG_USB_CATC is not set
# CONFIG_USB_KAWETH is not set
# Ethernet coverage (M32): Intel igb/e1000e/igc, Atheros/Killer alx,
# Broadcom tg3, Aquantia atlantic, Realtek r8169 (with phylib), and USB
# adapters (r8152, ASIX, iPhone tethering).
CONFIG_IGB=y
# CONFIG_IGB_HWMON is not set
# CONFIG_IGB_DCA is not set
CONFIG_E1000E=y
CONFIG_IGC=y
# CONFIG_IGBVF is not set
# CONFIG_IXGB is not set
# CONFIG_IXGBE is not set
# CONFIG_IXGBEVF is not set
# CONFIG_I40E is not set
# CONFIG_I40EVF is not set
# CONFIG_ICE is not set
# CONFIG_FM10K is not set
# CONFIG_IDPF is not set
# CONFIG_E100 is not set
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ALX=y
# CONFIG_ATL1 is not set
# CONFIG_ATL1E is not set
# CONFIG_ATL1C is not set
# CONFIG_ATL2 is not set
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
# CONFIG_TIGON3_HWMON is not set
# CONFIG_B44 is not set
# CONFIG_BCMGENET is not set
# CONFIG_BNX2 is not set
# CONFIG_CNIC is not set
# CONFIG_BNX2X is not set
# CONFIG_BNXT is not set
# CONFIG_SYSTEMPORT is not set
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
# CONFIG_8139CP is not set
# CONFIG_8139TOO is not set
# CONFIG_R8169_LEDS is not set
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
# CONFIG_PHYLIB_LEDS is not set
# CONFIG_LED_TRIGGER_PHY is not set
# CONFIG_SFP is not set
# CONFIG_FIXED_PHY is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_HWMON is not set
CONFIG_I2C=y
CONFIG_I2C_ALGOBIT=y
# CONFIG_I2C_CHARDEV is not set
# CONFIG_I2C_MUX is not set
# CONFIG_I2C_HELPER_AUTO is not set
# CONFIG_I2C_SMBUS is not set
# CONFIG_I2C_SLAVE is not set
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_IPHETH=y
# USB serial adapters and CDC ACM modems (M33): /dev/ttyUSB*, /dev/ttyACM*
# on RustOS terminals.
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_OPTION=y
# CONFIG_USB_SERIAL_CONSOLE is not set
# CONFIG_USB_SERIAL_SIMPLE is not set
CONFIG_USB_ACM=y
# SD/MMC (M33): Linux MMC core and SDHCI hosts (PCI, ACPI). Cards become
# RustOS block devices through c/mmc.c instead of Linux's mmc_block.
CONFIG_MMC=y
# CONFIG_MMC_BLOCK is not set
# CONFIG_MMC_TEST is not set
# CONFIG_SDIO_UART is not set
# CONFIG_MMC_CRYPTO is not set
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
# CONFIG_MMC_SDHCI_PLTFM is not set
# CONFIG_MMC_RICOH_MMC is not set
# CONFIG_MMC_TIFM_SD is not set
# CONFIG_MMC_CB710 is not set
# CONFIG_MMC_VIA_SDMMC is not set
# CONFIG_MMC_VUB300 is not set
# CONFIG_MMC_USHC is not set
# CONFIG_MMC_USDHI6ROL0 is not set
# CONFIG_MMC_REALTEK_PCI is not set
# CONFIG_MMC_REALTEK_USB is not set
# CONFIG_MMC_CQHCI is not set
# CONFIG_MMC_HSQ is not set
# CONFIG_MMC_TOSHIBA_PCI is not set
# CONFIG_MMC_MTK is not set
# CONFIG_MMC_SDHCI_XENON is not set
# CONFIG_MMC_SPI is not set
# CONFIG_MMC_WBSD is not set
# Input and HID (M33): Linux's input core with a RustOS handler (evdev
# nodes and the console), the HID core, generic and multitouch HID, USB HID
# and I2C HID (laptop touchpads and touchscreens).
CONFIG_INPUT=y
# CONFIG_INPUT_EVDEV is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_JOYDEV is not set
# CONFIG_INPUT_LEDS is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_SERIO is not set
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
# CONFIG_HID_BPF is not set
# CONFIG_HIDRAW is not set
# CONFIG_UHID is not set
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
# CONFIG_HID_BATTERY_STRENGTH is not set
# CONFIG_HID_HAPTIC is not set
CONFIG_USB_HID=y
# CONFIG_HID_PID is not set
# CONFIG_USB_HIDDEV is not set
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
# CONFIG_I2C_HID_OF is not set
# I2C-HID touchpads on AMD laptops (M33): ACPI platform devices, the
# DesignWare I2C controllers (AMDI0010), AMD GPIO (pinctrl-amd, AMDI0030)
# and gpiolib for the touchpads' GpioInt interrupts. Clocks are fixed
# rates from c/clk.c rather than the common clock framework's drivers.
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_GPIOLIB=y
# CONFIG_GPIO_CDEV is not set
# CONFIG_GPIO_SYSFS is not set
CONFIG_PINCTRL_AMD=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
# CONFIG_I2C_DESIGNWARE_SLAVE is not set
# CONFIG_I2C_DESIGNWARE_AMDPSP is not set
# CONFIG_I2C_DESIGNWARE_PCI is not set
# MediaTek MT7921AU USB Wi-Fi (M30).
CONFIG_MT7921U=y
# CONFIG_RFKILL is not set
# Off: RustOS provides these differently or not at all.
# CONFIG_MODULES is not set
# CONFIG_SYSFS is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_TRACING is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PARAVIRT is not set
# CONFIG_JUMP_LABEL is not set
# CONFIG_MITIGATION_RETPOLINE is not set
# CONFIG_CPU_MITIGATIONS is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
# CONFIG_LOCKDEP is not set
# CONFIG_PM_SLEEP is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_IA32_EMULATION is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_NETFILTER is not set
# CONFIG_IPV6 is not set
# EXPERT (for CFG80211_CERTIFICATION_ONUS) makes these optional; keep the
# defaults a non-expert configuration has.
CONFIG_SYSFS=y
CONFIG_BQL=y
CONFIG_RPS=y
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_X86_DEBUG_FPU is not set
