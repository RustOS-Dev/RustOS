--- a/include/__config
+++ b/include/__config
@@ -39,6 +39,17 @@
 #  define _LIBCPP_GCC_VER (__GNUC__ * 100 + __GNUC_MINOR__)
 #endif
 
+// GCC 16 workarounds (libc++ 18 predates it): it rejects its
+// type-transforming built-in traits (__decay, __remove_pointer, ...) in
+// function signatures, where libc++ uses them through aliases such as
+// __decay_t, so the library templates are used instead; and see
+// _LIBCPP_HIDE_FROM_ABI_VIRTUAL.
+#if defined(_LIBCPP_COMPILER_GCC) && _LIBCPP_GCC_VER >= 1600
+#  define _LIBCPP_GCC16_WORKAROUNDS 1
+#else
+#  define _LIBCPP_GCC16_WORKAROUNDS 0
+#endif
+
 #ifdef __cplusplus
 
 // Warn if a compiler version is used that is not supported anymore
@@ -858,7 +869,15 @@
 #  else
