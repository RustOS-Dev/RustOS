# ext4 feature matrix: one virtio-blk disk per mke2fs -O variant.
-drive if=none,id=f0,format=raw,file=@EXT4F:64:inline_data@
-device virtio-blk-pci,drive=f0
-drive if=none,id=f1,format=raw,file=@EXT4F:64:meta_bg,^resize_inode@
-device virtio-blk-pci,drive=f1
-drive if=none,id=f2,format=raw,file=@EXT4F:64:casefold@
-device virtio-blk-pci,drive=f2
-drive if=none,id=f3,format=raw,file=@EXT4F:64:large_dir@
-device virtio-blk-pci,drive=f3
-drive if=none,id=f4,format=raw,file=@EXT4F:64:ea_inode@
-device virtio-blk-pci,drive=f4
