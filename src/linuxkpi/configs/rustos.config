# Kconfig fragment for the Linux code RustOS compiles through LinuxKPI.
# Applied on top of `allnoconfig` (ARCH=x86_64) by tools/linux-import.py;
# the generated autoconf.h lands in src/linuxkpi/include/generated/.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_HZ_250=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_DYNAMIC is not set
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_SYMBOLIC_ERRNAME=y
CONFIG_MULTIUSER=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
# Device nodes: devtmpfs_create_node() is LinuxKPI glue (src/linuxkpi/c/chrdev.c)
# publishing into RustOS devfs; drivers/base/devtmpfs.c is not used.
CONFIG_DEVTMPFS=y
# Wi-Fi (M28): cfg80211, mac80211, the hwsim test radio. Crypto comes from
# LinuxKPI glue (src/linuxkpi/c/crypto.c on lib/crypto), not from crypto/.
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
# CONFIG_CFG80211_WEXT is not set
CONFIG_EXPERT=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS is not set
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
# CONFIG_MAC80211_LEDS is not set
# CONFIG_MAC80211_DEBUGFS is not set
# CONFIG_MAC80211_MESH is not set
CONFIG_MAC80211_HWSIM=y
# MediaTek MT7921/MT7921K/MT7920/MT7922 PCIe (M29). Tracing and debugfs are
# off, so the mt76 trace/debugfs files are not compiled.
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=y
# CONFIG_RFKILL is not set
# Off: RustOS provides these differently or not at all.
# CONFIG_MODULES is not set
# CONFIG_SYSFS is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_TRACING is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PARAVIRT is not set
# CONFIG_JUMP_LABEL is not set
# CONFIG_MITIGATION_RETPOLINE is not set
# CONFIG_CPU_MITIGATIONS is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
# CONFIG_LOCKDEP is not set
# CONFIG_PM_SLEEP is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_IA32_EMULATION is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_NETFILTER is not set
# CONFIG_IPV6 is not set
# EXPERT (for CFG80211_CERTIFICATION_ONUS) makes these optional; keep the
# defaults a non-expert configuration has.
CONFIG_SYSFS=y
CONFIG_BQL=y
CONFIG_RPS=y
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_X86_DEBUG_FPU is not set
