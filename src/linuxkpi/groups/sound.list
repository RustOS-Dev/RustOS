# ALSA (M34): the sound core (/dev/snd/*), PCM, controls, timers, jacks,
# and OSS emulation (/dev/dsp, /dev/mixer) for RustOS's audio tools.
module: soundcore
sound/sound_core.c
module: snd
sound/core/sound.c
