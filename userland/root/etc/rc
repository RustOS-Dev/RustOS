# System startup script (run by init).
mkdir -p /tmp /var/log /mnt
# Apply /storage/etc/network.conf (persistent) or /etc/network.conf.
# Interfaces not listed there keep the kernel's automatic DHCP.
ifup -a -q
# Join a saved wireless network (wifi.conf) in the background.
wifi auto -q &
# The desktop: eDEX-DE (ports/edex-de) on the first console, unless
# kernel.conf has desktop=none. The serial console keeps its shell.
if [ -x /usr/local/bin/edex-session ]; then
    edex-session --boot >>/var/log/edex-session.log 2>&1 </dev/null &
fi
